<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>NetScopePLC.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.11.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="app.ico" />
    <Resource Include="app-icon.png" />
    <EmbeddedResource Include="NetScopeNative.exe" LogicalName="NetScopeNative.exe" />
    <None Include="NetScopeNative.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" Condition="Exists('NetScopeNative.exe')" />
    <!-- 离线识别库：IEEE OUI 厂商表 + 主机名/厂商规则表，随 exe 一起分发，识别不依赖网络 -->
    <EmbeddedResource Include="data\oui.tsv" LogicalName="oui.tsv" />
    <EmbeddedResource Include="data\identify.tsv" LogicalName="identify.tsv" />
    <None Remove="data\oui.tsv" />
    <None Remove="data\identify.tsv" />
  </ItemGroup>
</Project>
