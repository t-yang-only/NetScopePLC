<Window x:Class="NetScopePLC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetScope PLC r6" Height="720" Width="1120" MinHeight="650" MinWidth="920"
        Background="{StaticResource Canvas}" FontFamily="Segoe UI Variable,Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="20"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="20"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="18"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal"><TextBlock Text="NetScope PLC" Foreground="{StaticResource Ink}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="r6" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="SemiBold" Margin="10,13,0,0"/></StackPanel>
        <TextBlock Text="工业设备网络发现与地址配置" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#E4F2EC" CornerRadius="14" Padding="12,6" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#188657" Margin="0,0,7,0"/><TextBlock Text="管理员模式" Foreground="#176044" FontSize="12" FontWeight="SemiBold"/></StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="8" Padding="22">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="扫描网卡" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="14"/>
          <ListBox x:Name="AdapterBox" Margin="0,9,0,0" Height="152" DisplayMemberPath="Display" SelectionChanged="AdapterBox_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="#DDE5E0" BorderThickness="1" Background="#FBFCFB"/>
          <TextBlock x:Name="AdapterDetail" Text="正在读取可用 IPv4 网卡..." Foreground="{StaticResource Muted}" FontSize="12" Margin="2,8,0,0" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="扫描方式" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
            <ComboBox x:Name="ScanModeBox" Width="210" Height="32" SelectedIndex="0" SelectionChanged="ScanModeBox_SelectionChanged">
              <ComboBoxItem Content="扫描本网段 IPv4 范围"/>
              <ComboBoxItem Content="扫描常见内网段"/>
              <ComboBoxItem Content="扫描手工网段"/>
            </ComboBox>
            <TextBox x:Name="ManualNetworkBox" Width="150" Height="32" Margin="10,0,0,0" Text="192.168.1.0/24" Visibility="Collapsed"/>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="2" Content="刷新网卡" Click="Refresh_Click" VerticalAlignment="Bottom"/>
      </Grid>
    </Border>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Surface}" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="22,20,22,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="发现的设备" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="16"/>
              <TextBlock x:Name="ResultSummary" Text="等待开始扫描" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <TextBlock x:Name="ScanBadge" Grid.Column="1" Text="空闲" Foreground="#596B65" Background="#EDF1EF" Padding="10,5" VerticalAlignment="Top"/>
          </Grid>
          <ProgressBar x:Name="ScanProgress" Grid.Row="1" Height="3" Margin="22,0" Minimum="0" Maximum="254" Foreground="{StaticResource Accent}" Background="#E7EEEA"/>
          <DataGrid x:Name="ResultsGrid" Grid.Row="2" Margin="22,17,22,20" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="ResultsGrid_SelectionChanged" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="42" Background="Transparent" AlternatingRowBackground="#F8FAF9">
            <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,0"/><Setter Property="Height" Value="34"/><Setter Property="Background" Value="#F5F8F6"/><Setter Property="BorderBrush" Value="#E1E8E4"/></Style></DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="IPv4 地址" Binding="{Binding Address}" Width="*"/>
              <DataGridTextColumn Header="延迟" Binding="{Binding Latency}" Width="110"/>
              <DataGridTextColumn Header="主机名" Binding="{Binding Host}" Width="1.2*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <StackPanel Grid.Column="2">
        <Border Background="{StaticResource Surface}" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel>
          <TextBlock Text="扫描控制" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="16"/>
          <Button x:Name="ScanButton" Content="开始扫描" Style="{StaticResource PrimaryButton}" Click="Scan_Click" Margin="0,16,0,8"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="PauseButton" Grid.Column="0" Content="暂停" Click="Pause_Click" IsEnabled="False"/>
            <Button x:Name="StopButton" Grid.Column="2" Content="停止" Click="Stop_Click" IsEnabled="False"/>
          </Grid>
          <TextBlock Text="无 IPv4 网卡也可扫描：常见网段模式会临时设置地址，完成后恢复。" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,15,0,0"/>
        </StackPanel></Border>
        <Border Background="{StaticResource Surface}" BorderBrush="#DDE5E0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,18,0,0"><StackPanel>
          <TextBlock Text="设备通信" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="16"/>
          <TextBlock x:Name="SelectedDevice" Text="选择一个设备以配置本机地址" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,16"/>
          <Button x:Name="ApplyButton" Content="使用设备所在网段" Style="{StaticResource PrimaryButton}" Click="Apply_Click" IsEnabled="False"/>
          <Button Content="恢复 DHCP 自动获取" Click="Dhcp_Click" Margin="0,8,0,0"/>
        </StackPanel></Border>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock x:Name="StatusText" Grid.Column="1" Text="就绪" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
