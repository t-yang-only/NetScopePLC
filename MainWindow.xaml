<Window x:Class="NetScopePLC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetScope PLC 0.10" Width="1180" Height="732" MinWidth="1000" MinHeight="680"
        Icon="pack://application:,,,/app.ico"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource Canvas}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True" SizeToContent="Manual">
  <Grid Margin="16" MinHeight="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="10"/>
      <RowDefinition Height="*" MinHeight="200"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="StatusText" Visibility="Collapsed" Height="0"/>
    <Ellipse x:Name="StatusDot" Visibility="Collapsed" Width="0" Height="0"/>

    <!-- 顶部：网卡 + 扫描方式 -->
    <Border Grid.Row="0" Style="{StaticResource Card}" MinHeight="0">
      <Grid MinHeight="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="118"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="扫描网卡" Style="{StaticResource SectionTitle}"/>
        <ListBox x:Name="AdapterBox" Grid.Row="1" Margin="0,8,0,0"
                 SelectionChanged="AdapterBox_SelectionChanged"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FBFCFB"
                 HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Padding" Value="10,5"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Display}" FontSize="13"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" Margin="0,8,0,4" Grid.IsSharedSizeScope="True">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto" MinHeight="38"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="ScanLabel"/>
            <ColumnDefinition Width="*" MinWidth="120"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="扫描方式" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
          <ComboBox x:Name="ScanModeBox" Grid.Row="0" Grid.Column="1" SelectedIndex="0" SelectionChanged="ScanModeBox_SelectionChanged">
            <ComboBoxItem Content="扫描本网段 IPv4 范围"/>
            <ComboBoxItem Content="扫描常见内网段"/>
            <ComboBoxItem Content="扫描手工网段"/>
          </ComboBox>
          <Button Grid.Row="0" Grid.Column="2" Content="刷新网卡" Click="Refresh_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
          <TextBlock x:Name="ManualNetworkLabel" Grid.Row="2" Grid.Column="0" Text="目标网段" VerticalAlignment="Center"
                     Foreground="{StaticResource Muted}" Margin="0,0,10,0" Visibility="Collapsed"/>
          <Grid x:Name="ManualRowPanel" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" MinHeight="38" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" MinWidth="150" MaxWidth="320"/>
              <ColumnDefinition Width="*" MinWidth="180"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ManualNetworkBox" Grid.Column="0" Margin="0,0,8,0" Text="192.168.0.0/24"
                     TextChanged="ManualNetworkBox_TextChanged"/>
            <UniformGrid x:Name="ManualPrefixPanel" Grid.Column="1" Columns="3" Margin="4,0,0,0">
              <Button x:Name="Prefix24Btn" Tag="24" Style="{StaticResource PrefixChipActive}" Click="ManualPrefix_Click"
                      ToolTip="/24 小规模：约 254 个地址，速度最快" Content="/24"/>
              <Button x:Name="Prefix16Btn" Tag="16" Style="{StaticResource PrefixChip}" Click="ManualPrefix_Click"
                      ToolTip="/16 中规模：约 6.5 万个地址，耗时较长" Content="/16"/>
              <Button x:Name="Prefix8Btn" Tag="8" Style="{StaticResource PrefixChip}" Click="ManualPrefix_Click"
                      ToolTip="/8 大规模：约 1677 万个地址，非常慢" Content="/8"/>
            </UniformGrid>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <!-- 主体：结果表 + 侧栏 -->
    <Grid Grid.Row="2" MinHeight="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="320"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="300" MinWidth="280" MaxWidth="340"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" MinHeight="0">
        <Grid MinHeight="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="80"/>
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="60"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="发现的设备" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="ResultSummary" Text="等待开始扫描" Style="{StaticResource SectionHint}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel x:Name="ScanProgressCluster" Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="8,0,8,0" Visibility="Collapsed">
              <Grid Width="52" Height="52">
                <Ellipse Width="44" Height="44" Stroke="#E7EEEA" StrokeThickness="4" Fill="Transparent"/>
                <Ellipse x:Name="ScanRingArc" Width="44" Height="44" Stroke="{StaticResource Accent}" StrokeThickness="4"
                         Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform>
                    <RotateTransform x:Name="ScanRingRotate" Angle="-90"/>
                  </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock x:Name="ScanRingPercent" Text="0%" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel Margin="6,0,0,0" VerticalAlignment="Center" MinWidth="72">
                <TextBlock x:Name="ScanRingSegment" Text="" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ScanEtaText" Text="" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="ScanBadge" Grid.Column="2" Text="空闲" Style="{StaticResource StatusBadge}" VerticalAlignment="Center"/>
          </Grid>
          <ProgressBar x:Name="ScanProgress" Visibility="Collapsed" Height="0"/>
          <TextBlock x:Name="EmptyState" Grid.Row="1" Text="等待开始扫描&#10;点击「开始扫描」发现设备"
                     Style="{StaticResource SectionHint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextAlignment="Center" IsHitTestVisible="False"/>
          <DataGrid x:Name="ResultsGrid" Grid.Row="1" MinHeight="0"
                    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    SelectionMode="Single" SelectionChanged="ResultsGrid_SelectionChanged"
                    HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal"
                    RowHeight="48" Background="Transparent" AlternatingRowBackground="#F8FAF9"
                    VerticalContentAlignment="Center" HorizontalAlignment="Stretch"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderBase}"/>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
              <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellBase}"/>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="IPv4 地址" Binding="{Binding Address}" Width="1.2*" MinWidth="88">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="延迟" Binding="{Binding Latency}" Width="0.5*" MinWidth="52">
                <DataGridTextColumn.HeaderStyle>
                  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderBase}">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="4,0"/>
                  </Style>
                </DataGridTextColumn.HeaderStyle>
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="设备型号" Width="2.3*" MinWidth="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding ModelLine}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelLine}"/>
                      <TextBlock Text="{Binding MacDisplay}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasMac}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- 侧栏 -->
      <Border Grid.Column="2" Style="{StaticResource SidebarCard}" MinHeight="0" ClipToBounds="True">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Top">
          <StackPanel Width="276">
            <TextBlock Text="扫描控制" Style="{StaticResource SectionTitle}"/>
            <Grid Margin="0,8,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="识别目标" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
              <ComboBox x:Name="TargetModeBox" Grid.Column="1" SelectedIndex="0">
                <ComboBoxItem Content="PLC / HMI"/>
                <ComboBoxItem Content="其他设备"/>
              </ComboBox>
            </Grid>
            <Button x:Name="ScanButton" Content="开始扫描" Style="{StaticResource SidebarPrimaryButton}" Click="Scan_Click" Margin="0,0,0,5"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="PauseButton" Style="{StaticResource SidebarButton}" Content="暂停" Click="Pause_Click" IsEnabled="False"/>
              <Button x:Name="StopButton" Grid.Column="2" Style="{StaticResource SidebarButton}" Content="停止" Click="Stop_Click" IsEnabled="False"/>
            </Grid>

            <Border Style="{StaticResource SidebarDivider}"/>

            <TextBlock Text="设备通信" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="IP 留空则 DHCP；掩码留空默认 255.255.255.0" Style="{StaticResource SectionHint}" Margin="0,4,0,8" TextWrapping="Wrap"/>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="IP" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="IpBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource SidebarField}"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="掩码" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="MaskBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource SidebarField}" ToolTip="留空默认 255.255.255.0"/>
              <TextBlock Grid.Row="4" Grid.Column="0" Text="网关" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="GatewayBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource SidebarField}" ToolTip="留空表示无网关"/>
              <TextBlock Grid.Row="6" Grid.Column="0" Text="DNS" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="DnsBox" Grid.Row="6" Grid.Column="1" Style="{StaticResource SidebarField}" ToolTip="留空不修改 DNS"/>
            </Grid>
            <Button x:Name="ApplyNetworkButton" Content="应用网络设置" Style="{StaticResource SidebarPrimaryButton}" Click="ApplyNetwork_Click"/>
            <Button x:Name="ApplyButton" Content="使用设备所在网段" Style="{StaticResource SidebarButton}" Click="Apply_Click" IsEnabled="False" Margin="0,5,0,0"/>
            <Button Content="恢复 DHCP" Style="{StaticResource SidebarButton}" Click="Dhcp_Click" Margin="0,5,0,0"/>
          </StackPanel>
        </Viewbox>
      </Border>
    </Grid>
  </Grid>
</Window>
