{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "构建并打开",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net10.0-windows/win-x64/NetScopePLC.exe",
            "args": [],
            "cwd": "${workspaceFolder}/bin/Debug/net10.0-windows/win-x64",
            "stopAtEntry": false
        },
        {
            "name": "命令行 --adapters",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net10.0-windows/win-x64/NetScopePLC.exe",
            "args": ["--adapters"],
            "cwd": "${workspaceFolder}/bin/Debug/net10.0-windows/win-x64",
            "stopAtEntry": false,
            "console": "integratedTerminal"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
